node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json

# pr-self-review run state: receipt, findings.json, pr-body.md. Per-clone and
# per-branch — and it MUST be ignored, not merely untracked: the receipt's
# staleness hash covers the untracked file set, so a tracked receipt would
# invalidate itself the moment it was written.
.claude/pr-self-review/
